{
  "title": "Facebook OSINT Actor",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "action": {
      "title": "Action",
      "type": "string",
      "description": "Select the Facebook operation.",
      "editor": "select",
      "default": "search",
      "enum": [
        "search",
        "posts",
        "pages",
        "profiles",
        "groups",
        "comments",
        "photos",
        "videos",
        "reels",
        "events"
      ]
    },
    "query": {
      "title": "Search Query",
      "type": "string",
      "description": "Keyword or phrase.",
      "editor": "textfield"
    },
    "url": {
      "title": "Facebook URL",
      "type": "string",
      "description": "Facebook URL.",
      "editor": "textfield"
    },
    "limit": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum number of results.",
      "editor": "number",
      "default": 20,
      "minimum": 1,
      "maximum": 1000
    },
    "headless": {
      "title": "Headless Browser",
      "type": "boolean",
      "description": "Run browser headless.",
      "editor": "checkbox",
      "default": true
    },
    "cookies": {
      "title": "Cookies",
      "type": "array",
      "description": "Facebook cookies.",
      "editor": "json"
    },
    "max_age_days": {
      "title": "Maximum Age (Days)",
      "type": "integer",
      "description": "Ignore older results.",
      "editor": "number",
      "default": 30
    }
  },
  "required": [
    "action"
  ]
}